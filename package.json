{
  "name": "ptxprint-mcp",
  "version": "0.4.0",
  "description": "PTXprint MCP server \u2014 stateless content-addressed Bible typesetting on Cloudflare Workers + Containers",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "tsc": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "test": "vitest run",
    "test:watch": "vitest",
    "bundle-policy": "node --import tsx/esm scripts/bundle-telemetry-policy.ts",
    "bundle-canon": "node --import tsx/esm scripts/bundle-canon.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@modelcontextprotocol/sdk": "1.30.1",
    "agents": "^0.24.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251024.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5",
    "wrangler": "^4.141.0"
  }
}
